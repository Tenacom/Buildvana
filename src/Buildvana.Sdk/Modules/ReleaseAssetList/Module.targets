<Project>
  
  <!-- The default for GenerateReleaseAssetList is true, except for libraries, test projects, and file-based apps -->
  <PropertyGroup Condition="'$(GenerateReleaseAssetList)' == ''">
    <GenerateReleaseAssetList>true</GenerateReleaseAssetList>
    <GenerateReleaseAssetList Condition="$(BV_IsLibraryProject) Or $(BV_IsTestProject) Or $(BV_IsFileBasedAppProject)">false</GenerateReleaseAssetList>
  </PropertyGroup>

  <!--
    Coalesce GenerateReleaseAssetList to a boolean value, defaulting to false.
    Store 'true' for any value MSBuild compares equal to it, such as 'yes'.
  -->
  <PropertyGroup Condition="'$(GenerateReleaseAssetList)' == 'true'">
    <GenerateReleaseAssetList>true</GenerateReleaseAssetList>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GenerateReleaseAssetList)' != 'true'">
    <GenerateReleaseAssetList>false</GenerateReleaseAssetList>
  </PropertyGroup>

  <Import Project="Module.Core.targets"
          Condition="$(GenerateReleaseAssetList)" />

</Project>
