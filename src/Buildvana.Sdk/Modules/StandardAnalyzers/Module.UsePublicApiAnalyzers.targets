<Project>

  <!-- Include public API analyzers. -->
  <ItemGroup>
    <BV_PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                         PrivateAssets="All"
                         IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <!--
    TFM-specific public API files are not added automatically by the analyzers.
    https://github.com/dotnet/roslyn-analyzers/blob/main/src/PublicApiAnalyzers/PublicApiAnalyzers.Help.md#conditional-api-differences
  -->
  <PropertyGroup>
    <UseTfmSpecificPublicApiFiles Condition="'$(UseTfmSpecificPublicApiFiles)' == '' And '$(TargetFrameworks)' == ''">false</UseTfmSpecificPublicApiFiles>
    <UseTfmSpecificPublicApiFiles Condition="'$(UseTfmSpecificPublicApiFiles)' == '' And '$(TargetFrameworks)' != ''">true</UseTfmSpecificPublicApiFiles>
    <UseTfmSpecificPublicApiFiles Condition="'$(UseTfmSpecificPublicApiFiles)' != 'true'">false</UseTfmSpecificPublicApiFiles>
  </PropertyGroup>
  <ItemGroup Condition="$(UseTfmSpecificPublicApiFiles)">
    <None Remove="PublicAPI.Shipped.txt" />
    <None Remove="PublicAPI.Unshipped.txt" />
    <AdditionalFiles Remove="PublicAPI.Shipped.txt" />
    <AdditionalFiles Remove="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup Condition="$(UseTfmSpecificPublicApiFiles) And '$(TargetFrameworks)' != ''">
    <None Include="PublicAPI\*\PublicAPI.Shipped.txt" />
    <None Include="PublicAPI\*\PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup Condition="$(UseTfmSpecificPublicApiFiles) And '$(TargetFramework)' != ''">
    <None Remove="PublicAPI\$(TargetFramework)\PublicAPI.Shipped.txt" />
    <None Remove="PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt" />
    <AdditionalFiles Condition="Exists('$(MSBuildProjectDirectory)\PublicAPI\$(TargetFramework)\PublicAPI.Shipped.txt')"
                     Include="PublicAPI\$(TargetFramework)\PublicAPI.Shipped.txt" />
    <AdditionalFiles Condition="Exists('$(MSBuildProjectDirectory)\PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt')"
                     Include="PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    The analyzers add no internal API file, in either layout.
    Each include follows a remove, so that a project that lists a file itself gets no duplicate.
    https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/PublicApiAnalyzers/PublicApiAnalyzers.Help.md#internal-api-tracking-and-internalsvisibleto
  -->
  <PropertyGroup>
    <UseTfmSpecificInternalApiFiles Condition="'$(UseTfmSpecificInternalApiFiles)' == '' And '$(TargetFrameworks)' == ''">false</UseTfmSpecificInternalApiFiles>
    <UseTfmSpecificInternalApiFiles Condition="'$(UseTfmSpecificInternalApiFiles)' == '' And '$(TargetFrameworks)' != ''">true</UseTfmSpecificInternalApiFiles>
    <UseTfmSpecificInternalApiFiles Condition="'$(UseTfmSpecificInternalApiFiles)' != 'true'">false</UseTfmSpecificInternalApiFiles>
  </PropertyGroup>
  <ItemGroup Condition="!$(UseTfmSpecificInternalApiFiles)">
    <AdditionalFiles Remove="InternalAPI.Shipped.txt" />
    <AdditionalFiles Remove="InternalAPI.Unshipped.txt" />
    <AdditionalFiles Condition="Exists('$(MSBuildProjectDirectory)\InternalAPI.Shipped.txt')"
                     Include="InternalAPI.Shipped.txt" />
    <AdditionalFiles Condition="Exists('$(MSBuildProjectDirectory)\InternalAPI.Unshipped.txt')"
                     Include="InternalAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup Condition="$(UseTfmSpecificInternalApiFiles) And '$(TargetFrameworks)' != ''">
    <None Include="InternalAPI\*\InternalAPI.Shipped.txt" />
    <None Include="InternalAPI\*\InternalAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup Condition="$(UseTfmSpecificInternalApiFiles) And '$(TargetFramework)' != ''">
    <None Remove="InternalAPI\$(TargetFramework)\InternalAPI.Shipped.txt" />
    <None Remove="InternalAPI\$(TargetFramework)\InternalAPI.Unshipped.txt" />
    <AdditionalFiles Remove="InternalAPI\$(TargetFramework)\InternalAPI.Shipped.txt" />
    <AdditionalFiles Remove="InternalAPI\$(TargetFramework)\InternalAPI.Unshipped.txt" />
    <AdditionalFiles Condition="Exists('$(MSBuildProjectDirectory)\InternalAPI\$(TargetFramework)\InternalAPI.Shipped.txt')"
                     Include="InternalAPI\$(TargetFramework)\InternalAPI.Shipped.txt" />
    <AdditionalFiles Condition="Exists('$(MSBuildProjectDirectory)\InternalAPI\$(TargetFramework)\InternalAPI.Unshipped.txt')"
                     Include="InternalAPI\$(TargetFramework)\InternalAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
