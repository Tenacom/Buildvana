<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Buildvana runtime</Title>
    <Summary>Typed model of Buildvana configuration and run-time information, shared by the bv tool, Buildvana SDK, and repository-owned hooks.</Summary>
    <Description>$(Summary)</Description>
    <PackageTags>build msbuild dotnet buildvana</PackageTags>
    <TargetFramework>$(StandardTfm)</TargetFramework>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <XmlDocs>true</XmlDocs> <!-- Read by the pinned Buildvana SDK. Remove once the pinned version reads GenerateDocumentationFile. -->
    <UsePublicApiAnalyzers>true</UsePublicApiAnalyzers>
  </PropertyGroup>

</Project>
