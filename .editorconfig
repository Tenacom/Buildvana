# IMPORTANT: Always keep EOL settings in sync with .editorconfig

# DO NOT remove the line below. Settings have to be consistent wherever the repo is checked out.
root = true

# Default settings
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# XML project files
[*.{slnx,csproj,proj,shproj,props,targets}]
indent_size = 2

# XML config files
[*.{ruleset,config,nuspec,resx,runsettings}]
indent_size = 2

# Other XML files
[*.{xml,svg}]
indent_size = 2

# JSON files
[*.{json,jsonc}]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Shell scripts
[*.{in,sh}]
indent_size = 2

# Windows batch files
[*.{bat,cmd}]
end_of_line = crlf

# Markdown files
[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

# InnoSetup files
[*.iss]
end_of_line = crlf
indent_size = 2

# ==============================================================================================
#                                    RESHARPER INSPECTIONS
# ----------------------------------------------------------------------------------------------
# This is the single source of truth for ReSharper inspection severities.
# DO NOT set severities in .DotSettings files, as precedence rules are unclear.
# Do not set them in .globalconfig either, because ReSharper will not read them from there.
# We only list non-default severities here, as the complete list would be over 1k lines long.
# Ordering and grouping follows the categories listed in the official documentation.
# Groups are listed even if empty, for reference.
# See https://www.jetbrains.com/help/resharper/Reference__Code_Inspections_CSHARP.html
# ----------------------------------------------------------------------------------------------
# Last updated: 2026-09-13 (ReSharper 2026.2)
# ==============================================================================================

[*.{cs,csx,cake}]

# Code Notification

# Common Practices and Code Improvements
resharper_can_replace_cast_with_lambda_return_type_highlighting = warning
resharper_convert_to_constant_local_highlighting = warning
resharper_annotate_not_null_parameter_highlighting = warning
resharper_annotate_can_be_null_parameter_highlighting = warning
resharper_annotate_not_null_type_member_highlighting = warning
resharper_annotate_can_be_null_type_member_highlighting = warning
resharper_can_simplify_dictionary_try_get_value_with_get_value_or_default_highlighting = warning
resharper_property_can_be_made_init_only_global_highlighting = warning

# Compiler Warnings

# Constraints Violations

# Entity Framework

# Formatting

# Grammar Issues

# Language Usage Opportunities
resharper_use_pattern_matching_highlighting = warning
resharper_convert_to_primary_constructor_highlighting = none
resharper_convert_to_local_function_highlighting = warning
resharper_use_await_using_highlighting = warning
resharper_convert_closure_to_method_group_highlighting = warning
resharper_use_verbatim_string_highlighting = none
resharper_merge_into_pattern_highlighting = warning
resharper_use_raw_string_highlighting = none
resharper_use_utf8_string_literal_highlighting = warning

# NUnit

# Potential Code Quality Issues
resharper_merge_cast_with_type_check_highlighting = warning

# Redundancies in Code
resharper_raw_string_can_be_simplified_highlighting = none
resharper_redundant_lambda_signature_parentheses_highlighting = warning

# Redundancies in Symbol Declarations

# Security

# Spelling Issues

# Syntax Style
resharper_arrange_redundant_parentheses_highlighting = warning
resharper_arrange_object_creation_when_type_not_evident_highlighting = none

# Unity

# Unity Burst Compiler Warnings

# Unity Performance Inspections

# Unreal Build System

# Xunit

# ==============================================================================================
#                                SOLUTION-SPECIFIC OVERRIDES
# ==============================================================================================

# Some types and members are unused but present for completeness and/or future use, or instantiated via DI.
# Sprinkling PublicAPI and/or UsedImplicitly attributes around would be mostly noise.
resharper_class_never_instantiated_global_highlighting = none
resharper_unused_type_global_highlighting = none
resharper_unused_member_global_highlighting = none
resharper_member_can_be_private_global_highlighting = none
