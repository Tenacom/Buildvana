// Buildvana configuration for the Buildvana repository itself, as it becomes once the wire
// model in main is released.
//
// buildvana.jsonc is what the pinned bv reads today. This file is what it will read, so it may
// state a setting the pinned version does not know, which is an error for it. The
// release/post-release hook copies this file over buildvana.jsonc, in the same commit that
// moves the tool pin, so the file and the tool that reads it arrive together.
//
// $schema points at main rather than at a released version, because the version this file
// describes does not exist yet. The hook pins it in the promoted copy; here it stays main.
//
// No comment here holds JSON. A commented-out member is parsed by nothing, so an omission
// worth recording gets one line of prose instead.
//
// Every edit to buildvana.jsonc belongs here as well. A test enforces it.
{
  "$schema": "https://raw.githubusercontent.com/Tenacom/Buildvana/main/schemas/buildvana.schema.json",

  "release": {
    "branches": ["^main$", "^v\\d+\\.\\d+$"],

    // No "configuration": releases are built with the default set under "dotnet" below.

    "checkPublicApi": true,

    // "stable" lets "Unreleased changes" accumulate across the whole preview line, folding it
    // into a version section only when a stable version is released.
    "changelogUpdates": "stable",

    // No "emptyChangelog": a stable release with nothing to say should stop us, not ship
    // quietly.

    "dogfood": true
  },

  "versioning": {
    "prereleaseTag": "preview",
    "assemblyVersionPrecision": "major"
  },

  "dotnet": {
    "configuration": "Release",

    // No "all", "restore", "build", "pack" or "nugetPush": nothing but the test run needs
    // extra arguments or environment variables.

    "test": {
      "args": ["--coverage", "--coverage-output-format", "cobertura"],
      "env": {}
    }
  },

  "nuget": {
    "feeds": {
      "prerelease": {
        "source": "https://f.feedz.io/tenacom/preview/nuget/index.json",
        "apiKeyEnv": "FEEDZ_IO_PRIVATE_TOKEN"
      },
      "release": {
        "source": "https://api.nuget.org/v3/index.json",
        "apiKeyEnv": "NUGET_DEPLOYMENT_KEY"
      }
    }
  },

  "github": {
    // Also the default. The release workflow points it at a PAT that can push to a protected
    // branch; the build workflow leaves it at the automatic token, which pull requests from
    // forks also get.
    "tokenEnv": "GITHUB_TOKEN"
  },

  // No "git": automated commits use the CI bot identity supplied by the server adapter.

  "dependencies": {

    // No "scopes": the built-in defaults are the ones this repository wants.

    // No "policies": no package here needs a policy of its own.

    "additionalPackages": {
      "SDK package injections": {
        "files": "src/Buildvana.Sdk/Sdk/PackageVersions.props",
        "items": "BV_PackageVersion"

        // No "policy": these are ordinary package pins, and move under the packages scope.
      }
    }
  },

  "fileBasedApps": ["/tools/", "/.claude/tools/"]
}
