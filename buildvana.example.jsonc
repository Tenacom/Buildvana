// Buildvana configuration: every setting, with its description and an
// example or default value.
//
// Generated by tools/generate-config-example.cs. Do not edit.
//
// Nothing reads this file. Buildvana looks only for buildvana.json and
// buildvana.jsonc, so copy the settings you want into one of those.
{
  // URI of the JSON schema describing this file.
  "$schema": "https://raw.githubusercontent.com/Tenacom/Buildvana/main/schemas/buildvana.schema.json",

  // Configuration for the bv release workflow.
  "release": {
    // Anchored regular expressions matching public-release branches.
    "branches": ["^main$", "^v\\d+\\.\\d+$"],

    // Build configuration for release artifacts. Defaults to dotnet.configuration.
    "configuration": "Release",

    // Whether public API files are checked before a release.
    "checkPublicApi": true,

    // Which releases require a changelog update.
    "changelogUpdates": "stable",

    // Text for a release with no changelog entries. Omitting it fails such a release.
    "emptyChangelog": "This release contains no user-visible changes.",

    // Whether self-references are updated (dogfooding) during a release.
    "dogfood": true,
  },

  // Configuration for version computation.
  "versioning": {
    // Prerelease tag. Without it, prerelease versions are not allowed.
    "prereleaseTag": "preview",

    // How many version components are carried into the assembly version.
    "assemblyVersionPrecision": "major",
  },

  // Configuration for invocations of the dotnet CLI.
  "dotnet": {
    // Default build configuration (e.g. Debug, Release).
    "configuration": "Release",

    // Invocation configuration common to all `dotnet` commands.
    "all": {
      // Extra arguments forwarded to `dotnet`.
      "args": ["--nologo"],

      // Environment variables forwarded to `dotnet`, keyed by variable name.
      "env": {"NUGET_XMLDOC_MODE": "skip"},
    },

    // Invocation configuration for the `dotnet restore` command.
    "restore": {
      // Extra arguments forwarded to `dotnet`.
      "args": ["--nologo"],

      // Environment variables forwarded to `dotnet`, keyed by variable name.
      "env": {"NUGET_XMLDOC_MODE": "skip"},
    },

    // Invocation configuration for the `dotnet build` command.
    "build": {
      // Extra arguments forwarded to `dotnet`.
      "args": ["--nologo"],

      // Environment variables forwarded to `dotnet`, keyed by variable name.
      "env": {"NUGET_XMLDOC_MODE": "skip"},
    },

    // Invocation configuration for the `dotnet test` command.
    "test": {
      // Extra arguments forwarded to `dotnet`.
      "args": ["--nologo"],

      // Environment variables forwarded to `dotnet`, keyed by variable name.
      "env": {"NUGET_XMLDOC_MODE": "skip"},
    },

    // Invocation configuration for the `dotnet pack` command.
    "pack": {
      // Extra arguments forwarded to `dotnet`.
      "args": ["--nologo"],

      // Environment variables forwarded to `dotnet`, keyed by variable name.
      "env": {"NUGET_XMLDOC_MODE": "skip"},
    },

    // Invocation configuration for the `dotnet nuget push` command.
    "nugetPush": {
      // Extra arguments forwarded to `dotnet`.
      "args": ["--nologo"],

      // Environment variables forwarded to `dotnet`, keyed by variable name.
      "env": {"NUGET_XMLDOC_MODE": "skip"},
    },
  },

  // Configuration for NuGet package publishing.
  "nuget": {
    // Push feeds, one per channel.
    "feeds": {
      // Feed that prerelease versions are pushed to. Defaults to the release feed.
      "prerelease": {
        // Source URL of the NuGet feed.
        "source": "https://api.nuget.org/v3/index.json",

        // Name of the environment variable that holds the feed API key.
        "apiKeyEnv": "NUGET_DEPLOYMENT_KEY",
      },

      // Feed that stable versions are pushed to.
      "release": {
        // Source URL of the NuGet feed.
        "source": "https://api.nuget.org/v3/index.json",

        // Name of the environment variable that holds the feed API key.
        "apiKeyEnv": "NUGET_DEPLOYMENT_KEY",
      },
    },
  },

  // Configuration for GitHub integration.
  "github": {
    // Name of the environment variable that holds the GitHub access token.
    "tokenEnv": "GITHUB_TOKEN",
  },

  // Configuration for Git-related behavior.
  "git": {
    // Git identity used by automated commits.
    "identity": {
      // Display name used as the Git author/committer.
      "name": "Buildvana Bot",

      // Email address used as the Git author/committer.
      "email": "bot@buildvana.invalid",
    },
  },

  // Configuration for dependency management.
  "dependencies": {
    // Update policy governing each dependency scope.
    "scopes": {
      // How far an automatic update may move the .NET SDK in global.json.
      "netsdk": "major",

      // How far an automatic update may move an MSBuild project SDK pin.
      "sdks": "minor",

      // How far an automatic update may move a .NET local tool pin.
      "tools": "minor",

      // How far an automatic update may move a NuGet package pin.
      "packages": "minor",
    },

    // Update policy of packages matching an id pattern. The first match wins.
    "policies": {
      // How far an automatic update may move a pin whose id matches.
      "Some.Package.*": "patch",
    },

    // Groups of package pins declared in their own files, keyed by caption.
    "additionalPackages": {
      "My package group": {
        // Home-relative glob selecting the files that declare the group's pins.
        "files": "path/to/MyPackages.props",

        // MSBuild item name the group's pins are declared as, e.g. BV_PackageVersion.
        "items": "PackageVersion",

        // How far an automatic update may move a pin of this group.
        "policy": "minor",
      },
    },
  },

  // Gitignore-syntax patterns naming the repository's file-based C# apps.
  "fileBasedApps": ["/tools/"],
}
