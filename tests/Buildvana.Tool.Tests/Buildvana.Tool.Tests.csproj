<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(StandardTfm)</TargetFramework>
    <ClsCompliant>false</ClsCompliant>
    <ImplicitUsings>true</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!-- The files under test: tests read the documentation pages that list the tool's diagnostics. -->
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Buildvana.Core.Testing\Buildvana.Core.Testing.csproj" />
    <ProjectReference Include="..\..\src\Buildvana.Tool\Buildvana.Tool.csproj" />
  </ItemGroup>

</Project>
