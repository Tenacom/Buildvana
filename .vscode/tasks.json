{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "type": "process",
      "command": "dotnet",
      "args": [
        "restore",
        "${workspaceFolder}",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}",
        "/maxCpuCount:1",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "pack",
      "type": "process",
      "command": "dotnet",
      "args": [
        "pack",
        "${workspaceFolder}",
        "/maxCpuCount:1",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "inspect",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "${workspaceFolder}/.claude/tools/inspect.cs"
      ],
      "problemMatcher": {
        "owner": "inspect",
        "source": "inspect",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+?)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\): (error|warning|info) (\\S+): (.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "inspect (with hints)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "${workspaceFolder}/.claude/tools/inspect.cs",
        "--all"
      ],
      "problemMatcher": {
        "owner": "inspect",
        "source": "inspect",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+?)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\): (error|warning|info) (\\S+): (.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      }
    }
  ]
}
