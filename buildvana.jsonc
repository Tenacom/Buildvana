// Buildvana configuration for the Buildvana repository itself.
//
// Two files hold it. buildvana.jsonc is what the pinned bv reads.
// buildvana.next.jsonc is what the next one will read, so it may state a
// setting the pinned version rejects. The release/post-release hook copies
// buildvana.next.jsonc over buildvana.jsonc, in the same commit that moves
// the tool pin, so the file and the tool that reads it arrive together.
//
// Every edit to one file belongs in the other. A test enforces it.
//
// For every setting Buildvana understands, with its description and an
// example value, see buildvana.example.jsonc.
//
// No comment here holds JSON. A commented-out member is parsed by nothing,
// so an omission worth recording gets one line of prose instead.
//
// buildvana.json and buildvana.jsonc are equivalent; keeping both in the
// same directory is an error. Comments and trailing commas are accepted in
// either, but only the .jsonc extension advertises the fact.
{
  // In buildvana.jsonc, the version pinned in .config/dotnet-tools.json. In
  // buildvana.next.jsonc, main: the version it describes does not exist yet.
  "$schema": "https://raw.githubusercontent.com/Tenacom/Buildvana/2.1.367-preview/schemas/buildvana.schema.json",

  "release": {
    "branches": ["^main$", "^v\\d+\\.\\d+$"],

    // No "configuration": releases use the default set under "dotnet" below.

    "checkPublicApi": true,

    // "stable" lets "Unreleased changes" accumulate across the whole preview
    // line, folding it into a version section only when a stable version is
    // released.
    "changelogUpdates": "stable",

    // No "emptyChangelog": a stable release with nothing to say should stop
    // us, not ship quietly.

    "dogfood": true
  },

  "versioning": {
    "prereleaseTag": "preview",
    "assemblyVersionPrecision": "major"
  },

  "dotnet": {
    "configuration": "Release",

    // No "all", "restore", "build", "pack" or "nugetPush": nothing but the
    // test run needs extra arguments or environment variables.

    "test": {
      "args": ["--coverage", "--coverage-output-format", "cobertura"],
      "env": {}
    }
  },

  "nuget": {
    "feeds": {
      "prerelease": {
        "source": "https://f.feedz.io/tenacom/preview/nuget/index.json",
        "apiKeyEnv": "FEEDZ_IO_PRIVATE_TOKEN"
      },
      "release": {
        "source": "https://api.nuget.org/v3/index.json",
        "apiKeyEnv": "NUGET_DEPLOYMENT_KEY"
      }
    }
  },

  "github": {
    // Also the default. The release workflow points it at a PAT that can push
    // to a protected branch; the build workflow leaves it at the automatic
    // token, which pull requests from forks also get.
    "tokenEnv": "GITHUB_TOKEN"
  },

  // No "git": automated commits use the CI bot identity supplied by the
  // server adapter.

  "fileBasedApps": ["/tools/", "/.claude/tools/"]
}
