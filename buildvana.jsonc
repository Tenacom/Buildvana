// Buildvana configuration for the Buildvana repository itself.
//
// This file doubles as a worked example: every setting Buildvana understands appears below, either carrying the
// value this repository uses or commented out with the reason it is not needed here. The comment introducing each
// setting is its description in schemas/buildvana.schema.json, the schema generated from the typed model.
//
// buildvana.json and buildvana.jsonc are equivalent; keeping both in the same directory is an error. Comments and
// trailing commas are accepted in either, but only the .jsonc name advertises the fact.
{
  // URI of the JSON schema describing this file.
  // This should point to the same version of Buildvana declared in .config\dotnet-tools.json
  "$schema": "https://raw.githubusercontent.com/Tenacom/Buildvana/2.1.367-preview/schemas/buildvana.schema.json",

  // Configuration for the bv release workflow.
  "release": {

    // Regular expressions (implicitly anchored, matched against the whole short branch name) identifying branches
    // that produce public releases.
    "branches": ["^main$", "^v\\d+\\.\\d+$"],

    // Build configuration used to produce release artifacts. Defaults to dotnet.configuration when omitted.
    // Not set: releases are built with the default configuration set under "dotnet" below.
    // "configuration": "Release",

    // Whether public API files are checked before a release.
    "checkPublicApi": true,

    // Which releases require a changelog update. One of: "none", "stable", "all".
    // "stable" lets the "Unreleased changes" section accumulate across the whole preview line, folding it into a
    // version section only when a stable version is released.
    "changelogUpdates": "stable",

    // Text substituted when a release has no changelog entries. When omitted or blank, an empty changelog fails the
    // release.
    // Not set on purpose: a stable release with nothing to say in the changelog should stop us, not ship quietly.
    // "emptyChangelog": "This release contains no user-visible changes.",

    // Whether self-references are updated (dogfooding) during a release.
    "dogfood": true
  },

  // Configuration for version computation.
  "versioning": {

    // Prerelease tag applied to prerelease versions. When omitted, prerelease versions are not allowed.
    "prereleaseTag": "preview",

    // How many version components are carried into the assembly version. One of: "major", "minor", "build".
    "assemblyVersionPrecision": "major"
  },

  // Configuration for invocations of the dotnet CLI.
  "dotnet": {

    // Default build configuration (e.g. Debug, Release).
    "configuration": "Release",

    // Invocation configuration common to all `dotnet` commands, and its per-command counterparts. Each takes the
    // same shape: "args" lists extra arguments forwarded to `dotnet`, "env" holds environment variables forwarded
    // to it, keyed by variable name. Arguments are appended in the order base -> dotnet.all -> per-command ->
    // arguments forwarded after `--` on the bv command line, so the command line always wins; environment
    // variables apply dotnet.all first, then the per-command entries.
    // Not set: this repository needs no extra arguments or environment variables anywhere.
    // "all": { "args": [], "env": {} },

    // Invocation configuration for the `dotnet restore` command.
    // "restore": { "args": [], "env": {} },

    // Invocation configuration for the `dotnet build` command.
    // "build": { "args": [], "env": {} },

    // Invocation configuration for the `dotnet test` command.
    "test": {
      "args": ["--coverage", "--coverage-output-format", "cobertura"],
      "env": {}
    },

    // Invocation configuration for the `dotnet pack` command.
    // "pack": { "args": [], "env": {} },

    // Invocation configuration for the `dotnet nuget push` command.
    // "nugetPush": { "args": [], "env": {} }
  },

  // Configuration for NuGet package publishing.
  "nuget": {

    // Push feeds, one per channel.
    "feeds": {

      // Feed that prerelease versions are pushed to. When omitted, prerelease versions are pushed to the release feed.
      "prerelease": {

        // Source URL of the NuGet feed.
        "source": "https://f.feedz.io/tenacom/preview/nuget/index.json",

        // Name of the environment variable that holds the feed API key.
        "apiKeyEnv": "FEEDZ_IO_PRIVATE_TOKEN"
      },

      // Feed that stable versions are pushed to.
      "release": {

        // Source URL of the NuGet feed.
        "source": "https://api.nuget.org/v3/index.json",

        // Name of the environment variable that holds the feed API key.
        "apiKeyEnv": "NUGET_DEPLOYMENT_KEY"
      }
    }
  },

  // Configuration for GitHub integration.
  "github": {

    // Name of the environment variable that holds the GitHub access token. GITHUB_TOKEN is also the default.
    // The release workflow points it at a PAT that can push to a protected branch; the build workflow leaves it at
    // the automatic token, which is also available to pull requests from forks.
    "tokenEnv": "GITHUB_TOKEN"
  },

  // Configuration for Git-related behavior.
  // Not set: automated commits use the CI bot identity supplied by the server adapter.
  // "git": {
  //
  //   // Git identity used by automated commits.
  //   "identity": {
  //
  //     // Display name used as the Git author/committer.
  //     "name": "Buildvana Bot",
  //
  //     // Email address used as the Git author/committer.
  //     "email": "bot@buildvana.invalid"
  //   }
  // },

  // Configuration for dependency management.
  // Commented out rather than absent: the bv version this repository pins does not know this section, and an
  // unknown setting is an error, so the block below has to wait for the first release that ships it.
  // The scopes and policies settings stay out even then: the built-in policies — major for netsdk, minor for
  // sdks, tools, and packages — are the ones this repository wants, and no package here needs its own.
  // "dependencies": {
  //
  //   // Groups of package pins declared in files of their own, keyed by the caption naming the group in
  //   // listings. Pins of a group are updated like any other package pin, but are never pruned and never
  //   // given transitive overrides.
  //   "additionalPackages": {
  //
  //     // The packages Buildvana SDK injects into the projects it builds.
  //     "SDK package injections": {
  //
  //       // Glob, relative to the home directory, selecting the files that declare the group's pins.
  //       "files": "src/Buildvana.Sdk/Sdk/PackageVersions.props",
  //
  //       // MSBuild item name the group's pins are declared as, e.g. BV_PackageVersion.
  //       "items": "BV_PackageVersion",
  //
  //       // How far an automatic update may move a pin of this group. A trailing - allows prerelease
  //       // versions. Defaults to the policy of the packages scope.
  //       // Not set: these pins are ordinary package pins and move under the packages scope policy.
  //       // "policy": "minor"
  //     }
  //   }
  // },

  // Gitignore-syntax patterns naming files and directories that hold file-based C# apps, added to the built-in
  // .buildvana/hooks/ scope. Commands that scan for #: directives read only .cs files within this scope.
  "fileBasedApps": ["/tools/", "/.claude/tools/"]
}
