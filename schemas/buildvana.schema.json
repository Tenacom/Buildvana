{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Buildvana configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "URI of the JSON schema describing this file.",
      "examples": [
        "https://raw.githubusercontent.com/Tenacom/Buildvana/main/schemas/buildvana.schema.json"
      ],
      "type": "string"
    },
    "release": {
      "description": "Configuration for the bv release workflow.",
      "type": "object",
      "properties": {
        "branches": {
          "description": "Anchored regular expressions matching public-release branches.",
          "examples": [
            [
              "^main$",
              "^v\\d\u002B\\.\\d\u002B$"
            ]
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "configuration": {
          "description": "Build configuration for release artifacts. Defaults to dotnet.configuration.",
          "examples": [
            "Release"
          ],
          "type": "string"
        },
        "checkPublicApi": {
          "description": "Whether public API files are checked before a release.",
          "type": "boolean",
          "default": true
        },
        "changelogUpdates": {
          "description": "Which releases require a changelog update.",
          "enum": [
            "none",
            "stable",
            "all"
          ],
          "default": "stable"
        },
        "emptyChangelog": {
          "description": "Text for a release with no changelog entries. Omitting it fails such a release.",
          "examples": [
            "This release contains no user-visible changes."
          ],
          "type": "string"
        },
        "dogfood": {
          "description": "Whether self-references are updated (dogfooding) during a release.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "versioning": {
      "description": "Configuration for version computation.",
      "type": "object",
      "properties": {
        "prereleaseTag": {
          "description": "Prerelease tag. Without it, prerelease versions are not allowed.",
          "examples": [
            "preview"
          ],
          "type": "string"
        },
        "assemblyVersionPrecision": {
          "description": "How many version components are carried into the assembly version.",
          "enum": [
            "major",
            "minor",
            "build"
          ],
          "default": "major"
        }
      },
      "additionalProperties": false
    },
    "dotnet": {
      "description": "Configuration for invocations of the dotnet CLI.",
      "type": "object",
      "properties": {
        "configuration": {
          "description": "Default build configuration (e.g. Debug, Release).",
          "type": "string",
          "default": "Release"
        },
        "all": {
          "description": "Invocation configuration common to all \u0060dotnet\u0060 commands.",
          "type": "object",
          "properties": {
            "args": {
              "description": "Extra arguments forwarded to \u0060dotnet\u0060.",
              "examples": [
                [
                  "--nologo"
                ]
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "description": "Environment variables forwarded to \u0060dotnet\u0060, keyed by variable name.",
              "examples": [
                {
                  "NUGET_XMLDOC_MODE": "skip"
                }
              ],
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "restore": {
          "description": "Invocation configuration for the \u0060dotnet restore\u0060 command.",
          "type": "object",
          "properties": {
            "args": {
              "description": "Extra arguments forwarded to \u0060dotnet\u0060.",
              "examples": [
                [
                  "--nologo"
                ]
              ],
              "$ref": "#/properties/dotnet/properties/all/properties/args"
            },
            "env": {
              "description": "Environment variables forwarded to \u0060dotnet\u0060, keyed by variable name.",
              "examples": [
                {
                  "NUGET_XMLDOC_MODE": "skip"
                }
              ],
              "$ref": "#/properties/dotnet/properties/all/properties/env"
            }
          },
          "additionalProperties": false
        },
        "build": {
          "description": "Invocation configuration for the \u0060dotnet build\u0060 command.",
          "type": "object",
          "properties": {
            "args": {
              "description": "Extra arguments forwarded to \u0060dotnet\u0060.",
              "examples": [
                [
                  "--nologo"
                ]
              ],
              "$ref": "#/properties/dotnet/properties/all/properties/args"
            },
            "env": {
              "description": "Environment variables forwarded to \u0060dotnet\u0060, keyed by variable name.",
              "examples": [
                {
                  "NUGET_XMLDOC_MODE": "skip"
                }
              ],
              "$ref": "#/properties/dotnet/properties/all/properties/env"
            }
          },
          "additionalProperties": false
        },
        "test": {
          "description": "Invocation configuration for the \u0060dotnet test\u0060 command.",
          "type": "object",
          "properties": {
            "args": {
              "description": "Extra arguments forwarded to \u0060dotnet\u0060.",
              "examples": [
                [
                  "--nologo"
                ]
              ],
              "$ref": "#/properties/dotnet/properties/all/properties/args"
            },
            "env": {
              "description": "Environment variables forwarded to \u0060dotnet\u0060, keyed by variable name.",
              "examples": [
                {
                  "NUGET_XMLDOC_MODE": "skip"
                }
              ],
              "$ref": "#/properties/dotnet/properties/all/properties/env"
            }
          },
          "additionalProperties": false
        },
        "pack": {
          "description": "Invocation configuration for the \u0060dotnet pack\u0060 command.",
          "type": "object",
          "properties": {
            "args": {
              "description": "Extra arguments forwarded to \u0060dotnet\u0060.",
              "examples": [
                [
                  "--nologo"
                ]
              ],
              "$ref": "#/properties/dotnet/properties/all/properties/args"
            },
            "env": {
              "description": "Environment variables forwarded to \u0060dotnet\u0060, keyed by variable name.",
              "examples": [
                {
                  "NUGET_XMLDOC_MODE": "skip"
                }
              ],
              "$ref": "#/properties/dotnet/properties/all/properties/env"
            }
          },
          "additionalProperties": false
        },
        "nugetPush": {
          "description": "Invocation configuration for the \u0060dotnet nuget push\u0060 command.",
          "type": "object",
          "properties": {
            "args": {
              "description": "Extra arguments forwarded to \u0060dotnet\u0060.",
              "examples": [
                [
                  "--nologo"
                ]
              ],
              "$ref": "#/properties/dotnet/properties/all/properties/args"
            },
            "env": {
              "description": "Environment variables forwarded to \u0060dotnet\u0060, keyed by variable name.",
              "examples": [
                {
                  "NUGET_XMLDOC_MODE": "skip"
                }
              ],
              "$ref": "#/properties/dotnet/properties/all/properties/env"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nuget": {
      "description": "Configuration for NuGet package publishing.",
      "type": "object",
      "properties": {
        "feeds": {
          "description": "Push feeds, one per channel.",
          "type": "object",
          "properties": {
            "prerelease": {
              "description": "Feed prerelease versions are pushed to. Defaults to the release feed.",
              "type": "object",
              "properties": {
                "source": {
                  "description": "Source URL of the NuGet feed.",
                  "examples": [
                    "https://api.nuget.org/v3/index.json"
                  ],
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "apiKeyEnv": {
                  "description": "Name of the environment variable that holds the feed API key.",
                  "examples": [
                    "NUGET_DEPLOYMENT_KEY"
                  ],
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "source",
                "apiKeyEnv"
              ],
              "additionalProperties": false
            },
            "release": {
              "description": "Feed that stable versions are pushed to.",
              "type": "object",
              "properties": {
                "source": {
                  "description": "Source URL of the NuGet feed.",
                  "examples": [
                    "https://api.nuget.org/v3/index.json"
                  ],
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "apiKeyEnv": {
                  "description": "Name of the environment variable that holds the feed API key.",
                  "examples": [
                    "NUGET_DEPLOYMENT_KEY"
                  ],
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "source",
                "apiKeyEnv"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "github": {
      "description": "Configuration for GitHub integration.",
      "type": "object",
      "properties": {
        "tokenEnv": {
          "description": "Name of the environment variable that holds the GitHub access token.",
          "type": "string",
          "default": "GITHUB_TOKEN"
        }
      },
      "additionalProperties": false
    },
    "git": {
      "description": "Configuration for Git-related behavior.",
      "type": "object",
      "properties": {
        "identity": {
          "description": "Git identity used by automated commits.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Display name used as the Git author/committer.",
              "examples": [
                "Buildvana Bot"
              ],
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "email": {
              "description": "Email address used as the Git author/committer.",
              "examples": [
                "bot@buildvana.invalid"
              ],
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "description": "Configuration for dependency management.",
      "type": "object",
      "properties": {
        "scopes": {
          "description": "Update policy governing each dependency scope.",
          "type": "object",
          "properties": {
            "netsdk": {
              "description": "How far an automatic update may move the .NET SDK in global.json.",
              "type": "string",
              "enum": [
                "disable",
                "disable-",
                "patch",
                "patch-",
                "feature",
                "feature-",
                "minor",
                "minor-",
                "major",
                "major-",
                "lts",
                "lts-"
              ],
              "default": "major"
            },
            "sdks": {
              "description": "How far an automatic update may move an MSBuild project SDK pin.",
              "type": "string",
              "enum": [
                "disable",
                "disable-",
                "exact",
                "exact-",
                "revision",
                "revision-",
                "patch",
                "patch-",
                "minor",
                "minor-",
                "major",
                "major-"
              ],
              "default": "minor"
            },
            "tools": {
              "description": "How far an automatic update may move a .NET local tool pin.",
              "type": "string",
              "enum": [
                "disable",
                "disable-",
                "exact",
                "exact-",
                "revision",
                "revision-",
                "patch",
                "patch-",
                "minor",
                "minor-",
                "major",
                "major-"
              ],
              "default": "minor"
            },
            "packages": {
              "description": "How far an automatic update may move a NuGet package pin.",
              "type": "string",
              "enum": [
                "disable",
                "disable-",
                "exact",
                "exact-",
                "revision",
                "revision-",
                "patch",
                "patch-",
                "minor",
                "minor-",
                "major",
                "major-"
              ],
              "default": "minor"
            }
          },
          "additionalProperties": false
        },
        "policies": {
          "description": "Update policy of packages matching an id pattern. The first match wins.",
          "type": "object",
          "additionalProperties": {
            "description": "How far an automatic update may move a pin whose id matches.",
            "examples": [
              "patch"
            ],
            "type": "string",
            "enum": [
              "disable",
              "disable-",
              "exact",
              "exact-",
              "revision",
              "revision-",
              "patch",
              "patch-",
              "minor",
              "minor-",
              "major",
              "major-"
            ]
          },
          "propertyNames": {
            "examples": [
              "Some.Package.*"
            ],
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalPackages": {
          "description": "Groups of package pins declared in their own files, keyed by caption.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "caption": false,
              "files": {
                "description": "Home-relative glob selecting the files that declare the group\u0027s pins.",
                "examples": [
                  "path/to/MyPackages.props"
                ],
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "items": {
                "description": "MSBuild item name the group\u0027s pins are declared as, e.g. BV_PackageVersion.",
                "examples": [
                  "PackageVersion"
                ],
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "policy": {
                "description": "How far an automatic update may move a pin of this group.",
                "examples": [
                  "minor"
                ],
                "type": "string",
                "enum": [
                  "disable",
                  "disable-",
                  "exact",
                  "exact-",
                  "revision",
                  "revision-",
                  "patch",
                  "patch-",
                  "minor",
                  "minor-",
                  "major",
                  "major-"
                ]
              }
            },
            "required": [
              "files",
              "items"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "examples": [
              "SDK package injections"
            ],
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "fileBasedApps": {
      "description": "Gitignore-syntax patterns naming the repository\u0027s file-based C# apps.",
      "examples": [
        [
          "/tools/"
        ]
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
